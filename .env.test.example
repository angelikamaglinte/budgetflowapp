# Copy this file to .env.test and fill in your TEST Supabase project's values.
# Never point this at your real/production Supabase project — E2E tests
# create and delete real rows.

VITE_SUPABASE_URL=https://your-test-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-test-project-anon-key

# Service role key (Project Settings -> API) — used ONLY by e2e/seed.ts to
# create the test account via the admin API. This one IS a real secret
# (bypasses RLS) — never commit it, never paste it in chat.
SUPABASE_SERVICE_ROLE_KEY=your-test-project-service-role-key

# The test account e2e/seed.ts creates (or reuses if it already exists).
TEST_USER_EMAIL=e2e-test@example.com
TEST_USER_PASSWORD=choose-a-password
